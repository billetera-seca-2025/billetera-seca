FROM python:3.12-slim

WORKDIR /app

# Copy requirements and install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy locust files
COPY locustfile.py .
COPY README.locust.md .

# Expose the port Locust runs on
EXPOSE 8089

# Run Locust with the target host from environment variable
CMD ["sh", "-c", "locust -f locustfile.py --host=${TARGET_HOST:-http://host.docker.internal:8080}"] 